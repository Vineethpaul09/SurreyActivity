{
  "name": "surrey-activity-booking",
  "version": "1.0.0",
  "description": "Automated booking system for City of Surrey drop-in sports activities",
  "main": "dist/booking.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/cli.ts",
    "start:prod": "node dist/scheduler.js start",
    "list:prod": "node dist/scheduler.js list",
    "book": "ts-node src/cli.ts book --",
    "book:all": "ts-node src/cli.ts book-all",
    "book:prod": "node dist/cli.js book --",
    "test": "ts-node src/cli.ts test-login",
    "deploy:build": "npm run build && echo Build complete — deploy dist/ to Pi",
    "pi": "powershell -ExecutionPolicy Bypass -File scripts/pi.ps1",
    "pi:status": "powershell -ExecutionPolicy Bypass -File scripts/pi.ps1 status",
    "pi:logs": "powershell -ExecutionPolicy Bypass -File scripts/pi.ps1 logs",
    "pi:logs-live": "powershell -ExecutionPolicy Bypass -File scripts/pi.ps1 logs-live",
    "pi:start": "powershell -ExecutionPolicy Bypass -File scripts/pi.ps1 start",
    "pi:stop": "powershell -ExecutionPolicy Bypass -File scripts/pi.ps1 stop",
    "pi:restart": "powershell -ExecutionPolicy Bypass -File scripts/pi.ps1 restart",
    "pi:deploy": "powershell -ExecutionPolicy Bypass -File scripts/pi.ps1 deploy",
    "pi:test": "powershell -ExecutionPolicy Bypass -File scripts/pi.ps1 test",
    "pi:info": "powershell -ExecutionPolicy Bypass -File scripts/pi.ps1 info",
    "pi:ssh": "powershell -ExecutionPolicy Bypass -File scripts/pi.ps1 ssh"
  },
  "keywords": [
    "surrey",
    "booking",
    "automation",
    "playwright"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "commander": "^11.1.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.3.1",
    "node-cron": "^4.2.1",
    "playwright": "^1.40.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
